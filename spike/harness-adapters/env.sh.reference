#!/usr/bin/env bash
# Isolation wrapper for the herdctl harness-adapter spike.
#
# Source this (don't exec it) before running anything that launches Pi or Codex:
#   . /data/paddock-servers/harness-spike/env.sh
#
# WHY THIS IS NOT OPTIONAL ON THIS BOX
# $HOME here is /data, and /data/.claude is PRODUCTION Paddock's real Claude
# home -- hundreds of real transcripts and a live login. Any harness that
# resolves its config via os.homedir() or ~ would land there. Two agents have
# already walked into that trap on this box. So we hand every harness a
# throwaway HOME and an explicit per-harness config dir, and then VERIFY what
# the process actually resolved rather than trusting that the env var was read.

set -u

SPIKE_ROOT=/data/paddock-servers/harness-spike

# --- throwaway HOME ----------------------------------------------------------
export HOME="$SPIKE_ROOT/home"

# --- per-harness isolated config/state dirs ---------------------------------
export CODEX_HOME="$SPIKE_ROOT/codex-home"
# Pi stores session JSONL trees under its agent dir; PI_HOME covers the
# documented override, and HOME above is the backstop if it only honours ~.
export PI_HOME="$SPIKE_ROOT/pi-home"
export PI_CONFIG_DIR="$SPIKE_ROOT/pi-home"

# Belt and braces: if anything still tries to reach a Claude home, send it
# somewhere harmless rather than production's.
export CLAUDE_CONFIG_DIR="$SPIKE_ROOT/home/.claude-throwaway"

mkdir -p "$HOME" "$CODEX_HOME" "$PI_HOME" "$CLAUDE_CONFIG_DIR" \
         "$SPIKE_ROOT/work" "$SPIKE_ROOT/logs"

# --- credentials -------------------------------------------------------------
# Values are never printed. Only the fact of presence is reported.
if [ -f "$SPIKE_ROOT/secrets.env" ]; then
  set -a
  # shellcheck disable=SC1091
  . "$SPIKE_ROOT/secrets.env"
  set +a
fi

# --- dev tooling expects NODE_ENV unset on this box -------------------------
unset NODE_ENV

spike_env_report() {
  echo "--- spike isolation ---"
  echo "HOME               = $HOME"
  echo "CODEX_HOME         = $CODEX_HOME"
  echo "PI_HOME            = $PI_HOME"
  echo "CLAUDE_CONFIG_DIR  = $CLAUDE_CONFIG_DIR"
  echo "OPENROUTER_API_KEY = $([ -n "${OPENROUTER_API_KEY:-}" ] && echo "present (${#OPENROUTER_API_KEY} chars)" || echo "EMPTY")"
  echo "OPENAI_API_KEY     = $([ -n "${OPENAI_API_KEY:-}" ] && echo "present (${#OPENAI_API_KEY} chars)" || echo "EMPTY")"
  case "$HOME" in
    /data) echo "FATAL: HOME is /data -- production Claude home. Refusing."; return 1 ;;
  esac
  if [ -e /data/.claude ] && [ "$HOME" = "/data" ]; then
    echo "FATAL: would touch production /data/.claude"; return 1
  fi
  echo "ok: production /data/.claude is NOT in any harness's resolution path"
  echo "-----------------------"
}
